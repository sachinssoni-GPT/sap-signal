# Local runs only (WSL). In GitHub Actions these are repository secrets. Never commit .env.
OPENAI_API_KEY=
TAVILY_API_KEY=

# Approval links (same value as the Worker secret). Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APPROVAL_SECRET=

# Email (Gmail: turn on 2-Step Verification, then create an App Password)
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
EMAIL_TO=you@gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Words that must never appear in anything published (employer, clients), comma-separated
BANNED_TERMS=
